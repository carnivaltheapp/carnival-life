{
  "name": "carnival-life",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@carnival/playhouse",
    "lint": "npm run lint --workspace=@carnival/playhouse",
    "typecheck": "npm run typecheck --workspace=@carnival/playhouse",
    "build": "npm run build --workspace=@carnival/playhouse",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "supabase": "2.115.0"
  }
}
