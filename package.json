{
  "name": "carnival-life",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@carnival/playhouse",
    "lint": "npm run lint --workspace=@carnival/playhouse && npm run lint:desktop",
    "lint:desktop": "eslint extensions/chrome --config extensions/chrome/eslint.config.mjs --max-warnings=0",
    "typecheck": "npm run typecheck --workspace=@carnival/playhouse",
    "test": "npm run test --workspace=@carnival/playhouse",
    "test:desktop": "node --check extensions/chrome/aux-routing.js && node --check extensions/chrome/background.js && node --check extensions/chrome/gmail-drag-bridge.js && node --check extensions/chrome/playhouse-bridge.js && node --check extensions/chrome/workspace-controller.js && node --check extensions/chrome/workspace-summon.js && node --test extensions/chrome/aux-routing.test.mjs extensions/chrome/gmail-drag-bridge.test.mjs extensions/chrome/playhouse-bridge.test.mjs extensions/chrome/workspace-controller.test.mjs extensions/chrome/workspace-summon.test.mjs",
    "migration:legacy:dry-run": "node --env-file=.env.local --import tsx apps/playhouse/migration/legacy/cli.ts",
    "migration:legacy:full": "node --env-file=.env.local --env-file-if-exists=apps/playhouse/.env.local --import tsx apps/playhouse/migration/legacy/full-cli.ts",
    "migration:legacy:up": "node --env-file=.env.local --env-file-if-exists=apps/playhouse/.env.local --import tsx apps/playhouse/migration/legacy/full-cli.ts --task-types up",
    "migration:legacy:pilot": "node --env-file=.env.local --env-file-if-exists=apps/playhouse/.env.local --import tsx apps/playhouse/migration/legacy/pilot-cli.ts",
    "migration:legacy:pilot:rollback": "node --env-file-if-exists=.env.local --env-file-if-exists=apps/playhouse/.env.local --import tsx apps/playhouse/migration/legacy/pilot-rollback-cli.ts",
    "test:migration": "npm run test --workspace=@carnival/playhouse -- --run migration/legacy",
    "test:e2e": "npm run test:e2e --workspace=@carnival/playhouse --",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=@carnival/playhouse --",
    "build": "npm run build --workspace=@carnival/playhouse",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "mongodb": "7.6.0",
    "supabase": "2.115.0",
    "tsx": "4.23.12"
  }
}
