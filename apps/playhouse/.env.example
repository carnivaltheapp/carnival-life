# Hosted Carnival Supabase project (public browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Play storage. Omit or use mongo for the temporary legacy-backed phase.
PLAYHOUSE_DATA_SOURCE=mongo
LEGACY_MONGO_URI=mongodb+srv://server-only-placeholder

# Server-only values. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
GMAIL_PUBSUB_TOPIC=projects/your-google-cloud-project/topics/carnival-gmail-incoming
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-google-cloud-project/subscriptions/carnival-gmail-incoming-push
GMAIL_PUBSUB_AUDIENCE=https://carnival-playhouse.vercel.app/api/incoming/gmail/pubsub
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=carnival-gmail-push@your-google-cloud-project.iam.gserviceaccount.com
CRON_SECRET=generate-a-long-random-server-only-secret
CARNIVAL_ROADMAP_READ_TOKEN=generate-a-cryptographically-strong-server-only-read-token
SLACK_OAUTH_CLIENT_ID=your-slack-client-id
SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret
SLACK_OAUTH_REDIRECT_URI=http://localhost:3002/slack/callback
SLACK_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
