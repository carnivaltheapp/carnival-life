{
  "manifest_version": 3,
  "name": "Carnival Desktop Workspace",
  "version": "0.3.0",
  "description": "Coordinates the PlayHouse and Carnival context Chrome windows.",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "system.display",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://carnival-playhouse.vercel.app/*",
        "http://localhost/*"
      ],
      "js": ["playhouse-bridge.js"]
    }
  ],
  "action": {
    "default_title": "Summon Carnival workspace"
  }
}
